      const section = document.getElementById('new-arrivals-{{ section.id }}');
      if(!section) return;

      const row = section.querySelector('.na-row');
      const cards = Array.from(section.querySelectorAll('.na-card'));

      // Attach variant/quick-add data to each card
      cards.forEach(card => {
        const handle = card.getAttribute('data-product-handle');
        // We embed variant data in a data attribute via Liquid for each card
        // Generate variants JSON in a hidden script tag per card
      });

      // Build a map of product variants using inline JSON rendered by Liquid
      // We will render the variants data into a JS object
    });
  </script>

  {% comment %} Render variants data and attach behavior in a single script for performance {% endcomment %}
  <script>
    document.addEventListener('DOMContentLoaded', function(){
      const section = document.getElementById('new-arrivals-{{ section.id }}');
      if(!section) return;

      const cards = Array.from(section.querySelectorAll('.na-card'));

      // Build product data map from Liquid
      const PRODUCT_DATA = {
        {% for product in products %}
          "{{ product.id }}": {
            "id": {{ product.id }},
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "handle": {{ product.handle | json }},
            "variants": {{ product.variants | json }}
          }{% if forloop.last == false %},{% endif %}
        {% endfor %}
      };

      // Helpers
      function findCardByProductId(id){ return section.querySelector('.na-card[data-product-id="'+id+'"]'); }

      // Attach UI behaviour to each card
      cards.forEach(card => {
        const productId = card.getAttribute('data-product-id');
        const pdata = PRODUCT_DATA[productId];
        if(!pdata) return;

        const quickBtn = card.querySelector('[data-action="quick-add"]');
        const variantList = card.querySelector('.na-variant-list');

        // Prepare variant pills HTML
        function showVariantList(){
          variantList.innerHTML = '';
          pdata.variants.forEach(v => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'na-variant';
            btn.textContent = v.title || v.option1 || 'Select';
            btn.dataset.variantId = v.id;
            btn.disabled = !v.available;
            btn.addEventListener('click', function(){
              // mark selected
              variantList.querySelectorAll('.na-variant').forEach(n=>n.classList.remove('selected'));
              btn.classList.add('selected');
              addToCart(v.id, card, true);
            });
            variantList.appendChild(btn);
          });
          variantList.style.display = 'flex';
          card.classList.add('open');
        }

        function hideVariantList(){ variantList.style.display = 'none'; card.classList.remove('open'); }

        // Quick add click
        quickBtn && quickBtn.addEventListener('click', function(e){
          e.preventDefault();
          if(pdata.variants.length === 1){
            const vid = pdata.variants[0].id;
            addToCart(vid, card, false);
          } else {
            // Show variant selector inline
            showVariantList();
          }
        });
      });

      // Add to cart via AJAX
      function addToCart(variantId, card, invokedFromSelector){
        const btn = card.querySelector('[data-action="quick-add"]');
        if(!btn) return;

        // show loading state
        const spinner = document.createElement('span'); spinner.className = 'na-spinner';
        const prevText = btn.textContent;
        btn.textContent = '';
        btn.appendChild(spinner);
        btn.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        }).then(function(res){
          return res.json();
        }).then(function(data){
          // restore button
          btn.removeChild(spinner);
          btn.textContent = prevText;
          btn.disabled = false;

          // dispatch open event
          document.dispatchEvent(new CustomEvent('cart:open'));
          // hide variant list if present
          const variantList = card.querySelector('.na-variant-list');
          if(variantList){ variantList.style.display = 'none'; }
        }).catch(function(err){
          console.error('Add to cart failed', err);
          btn.removeChild(spinner);
          btn.textContent = prevText;
          btn.disabled = false;
        });
      }

      /* CART DRAWER LOGIC */
      const overlay = section.querySelector('.na-cart-overlay');
      const drawer = section.querySelector('.na-cart-drawer');
      const closeBtn = section.querySelector('.na-cart-close');
      const itemsContainer = section.querySelector('.na-cart-items');
      const subtotalEl = section.querySelector('.na-subtotal-amount');

      function openDrawer(){ overlay.classList.add('open'); drawer.classList.add('open'); drawer.setAttribute('aria-hidden','false'); overlay.setAttribute('aria-hidden','false'); fetchCart(); }
      function closeDrawer(){ overlay.classList.remove('open'); drawer.classList.remove('open'); drawer.setAttribute('aria-hidden','true'); overlay.setAttribute('aria-hidden','true'); }

      document.addEventListener('cart:open', openDrawer);
      overlay.addEventListener('click', closeDrawer);
      closeBtn.addEventListener('click', closeDrawer);
      document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeDrawer(); });

      function fetchCart(){ fetch('/cart.js').then(r=>r.json()).then(renderCart).catch(e=>console.error(e)); }

      function renderCart(cart){
        itemsContainer.innerHTML = '';
        if(!cart || !cart.items) return;
        subtotalEl.textContent = Shopify.formatMoney ? Shopify.formatMoney(cart.total_price) : (cart.total_price/100).toFixed(2);

        cart.items.forEach(item => {
          const el = document.createElement('div'); el.className = 'na-cart-item';
          el.innerHTML = `
            <img src="${(item.image || '')}" alt="${item.title}">
            <div style="flex:1;">
              <div style="font-size:13px;font-weight:500;">${item.product_title}</div>
              <div style="font-size:12px;color:#666">${item.variant_title || ''}</div>
              <div style="margin-top:8px;display:flex;justify-content:space-between;align-items:center;">
                <div class=\"na-qty\"> <button data-action=\"decrease\" data-key=\"${item.key}\">-</button><span style=\"margin:0 8px;\">${item.quantity}</span><button data-action=\"increase\" data-key=\"${item.key}\">+</button></div>
                <div style=\"font-weight:600\">${(item.line_price/100).toFixed(2)}</div>
              </div>
              <div style=\"margin-top:8px;\"><a href=\"#\" data-action=\"remove\" data-key=\"${item.key}\">Remove</a></div>
            </div>
          `;
          itemsContainer.appendChild(el);
        });

        // attach handlers
        itemsContainer.querySelectorAll('[data-action="increase"]').forEach(btn=>btn.addEventListener('click', changeQty));
        itemsContainer.querySelectorAll('[data-action="decrease"]').forEach(btn=>btn.addEventListener('click', changeQty));
        itemsContainer.querySelectorAll('[data-action="remove"]').forEach(btn=>btn.addEventListener('click', removeItem));
      }

      function changeQty(e){ e.preventDefault(); const key = e.currentTarget.dataset.key; const isInc = e.currentTarget.dataset.action === 'increase'; // get current qty from DOM by searching parent
        const parent = e.currentTarget.closest('.na-cart-item'); const qtySpan = parent.querySelector('span'); let current = parseInt(qtySpan.textContent,10) || 1; const newQty = isInc ? current + 1 : Math.max(0, current - 1);
        updateCartItem(key, newQty);
      }

      function removeItem(e){ e.preventDefault(); const key = e.currentTarget.dataset.key; updateCartItem(key, 0); }

      function updateCartItem(key, quantity){ fetch('/cart/change.js', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ id: key, quantity: quantity }) }).then(r=>r.json()).then(function(cart){ renderCart(cart); updateHeaderCount(cart.item_count); }).catch(e=>console.error(e)); }

      function updateHeaderCount(count){ document.querySelectorAll('[data-cart-count]').forEach(n=>{ n.textContent = count; }); }

    });
  </script>

{% schema %}
{
  "name": "New Arrivals",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading", "default": "New Arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "card_width_desktop", "label": "Card width (desktop)", "min": 260, "max": 400, "step": 1, "default": 320 },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show sale badge", "default": true },
    { "type": "text", "id": "quick_add_label", "label": "Quick add label", "default": "QUICK ADD" }
  ]
}
{% endschema %}
