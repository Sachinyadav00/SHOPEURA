{% comment %}
  New Arrivals Section
  - Horizontally scrollable product carousel
  - Image swap on hover, quick-add with variant handling
  - Self-contained cart drawer with AJAX add/change/remove
  - All CSS scoped under #new-arrivals-{{ section.id }}
{% endcomment %}

{% assign collection = collections[section.settings.collection] %}
{% assign products = collection.products | default: null %}
{% if products and products.size > 0 %}
  {% assign products = products | slice: 0, section.settings.products_count %}
{% else %}
  {% assign products = '' | split: ',' %}
{% endif %}

<section id="new-arrivals-{{ section.id }}" class="section-new-arrivals">
  <style>
    /* Placeholder for external stylesheet: {{ 'section-new-arrivals' | asset_url | stylesheet_tag }} */

    #new-arrivals-{{ section.id }} { --card-gap: 16px; --card-width-desktop: {{ section.settings.card_width_desktop | default: 320 }}px; --card-width-mobile: 240px; }

    #new-arrivals-{{ section.id }} .na-inner { max-width: 1400px; margin: 0 auto; padding: 48px 20px; }
    #new-arrivals-{{ section.id }} .na-heading { font-family: var(--font-heading-family); font-size: 28px; margin: 0 0 18px; }

    /* Carousel row */
    #new-arrivals-{{ section.id }} .na-row { display:flex; gap: var(--card-gap); overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; -webkit-overflow-scrolling: touch; }
    #new-arrivals-{{ section.id }} .na-row::-webkit-scrollbar { display: none; }
    #new-arrivals-{{ section.id }} .na-row { scrollbar-width: none; }

    /* Card */
    #new-arrivals-{{ section.id }} .na-card { scroll-snap-align: start; flex: 0 0 var(--card-width-desktop); width: var(--card-width-desktop); background: transparent; border: none; }
    @media (max-width: 749px) { #new-arrivals-{{ section.id }} .na-card { flex: 0 0 var(--card-width-mobile); width: var(--card-width-mobile); } }

    /* Image area */
    #new-arrivals-{{ section.id }} .na-image-wrap { position: relative; width: 100%; aspect-ratio: 2 / 3; overflow: hidden; }
    #new-arrivals-{{ section.id }} .na-image { width:100%; height:100%; object-fit: cover; object-position: center top; display:block; transition: opacity 0.45s ease, transform 0.6s ease; }
    #new-arrivals-{{ section.id }} .na-image--secondary { position:absolute; inset:0; top:0; left:0; width:100%; height:100%; opacity:0; transition: opacity 0.45s ease; }
    #new-arrivals-{{ section.id }} .na-card:hover .na-image--secondary { opacity:1; }
    #new-arrivals-{{ section.id }} .na-card:hover .na-image--primary { opacity:0; }

    /* Quick add slides from bottom */
    #new-arrivals-{{ section.id }} .na-quick-wrap { position:absolute; left:0; right:0; bottom:0; transform: translateY(100%); transition: transform 0.35s ease; z-index:3; }
    #new-arrivals-{{ section.id }} .na-card:hover .na-quick-wrap, #new-arrivals-{{ section.id }} .na-card.open .na-quick-wrap { transform: translateY(0); }

    #new-arrivals-{{ section.id }} .na-quick { width:100%; border: none; padding: 14px 0; background: rgba(255,255,255,0.92); color: #1a1a1a; font-family: var(--font-body-family); font-size:11px; letter-spacing:0.15em; font-weight:600; text-transform:uppercase; cursor:pointer; }
    #new-arrivals-{{ section.id }} .na-quick:hover { background:#1a1a1a; color:#fff; transition: background 0.2s ease, color 0.2s ease; }

    /* Variant selector when needed (pills) */
    #new-arrivals-{{ section.id }} .na-variant-list { display:flex; gap:8px; padding:12px; background: rgba(255,255,255,0.94); }
    #new-arrivals-{{ section.id }} .na-variant { padding:8px 12px; border:1px solid #e6e6e6; background:#fff; cursor:pointer; font-size:12px; }
    #new-arrivals-{{ section.id }} .na-variant.selected { background:#1a1a1a; color:#fff; border-color:#1a1a1a; }

    /* Info area */
    #new-arrivals-{{ section.id }} .na-info { padding:12px 4px 0; }
    #new-arrivals-{{ section.id }} .na-title { font-family: var(--font-heading-family); font-size:13px; font-weight:500; letter-spacing:0.02em; margin:0 0 6px; color: #111; }
    #new-arrivals-{{ section.id }} .na-price { font-family: var(--font-body-family); font-size:13px; color:#1a1a1a; }
    #new-arrivals-{{ section.id }} .na-compare { text-decoration: line-through; color: #8a8a8a; margin-right:8px; }

    /* Cart drawer */
    #new-arrivals-{{ section.id }} .na-cart-overlay { position:fixed; inset:0; background: rgba(0,0,0,0.35); z-index:999; opacity:0; pointer-events:none; transition: opacity 0.25s ease; }
    #new-arrivals-{{ section.id }} .na-cart-overlay.open { opacity:1; pointer-events:auto; }
    #new-arrivals-{{ section.id }} .na-cart-drawer { position:fixed; top:0; right:0; height:100%; width:420px; max-width:100vw; background:#fff; z-index:1000; transform: translateX(100%); transition: transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94); display:flex; flex-direction:column; }
    #new-arrivals-{{ section.id }} .na-cart-drawer.open { transform: translateX(0); }
    #new-arrivals-{{ section.id }} .na-cart-header { padding:18px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #e8e8e8; }
    #new-arrivals-{{ section.id }} .na-cart-title { font-family:var(--font-heading-family); font-size:14px; letter-spacing:0.12em; }
    #new-arrivals-{{ section.id }} .na-cart-items { padding:12px; overflow-y:auto; flex:1; }
    #new-arrivals-{{ section.id }} .na-cart-item { display:flex; gap:12px; padding:10px 0; border-bottom:1px solid #f2f2f2; }
    #new-arrivals-{{ section.id }} .na-cart-item img { width:60px; height:80px; object-fit:cover; }
    #new-arrivals-{{ section.id }} .na-cart-footer { padding:14px; border-top:1px solid #e8e8e8; }
    #new-arrivals-{{ section.id }} .na-checkout { width:100%; background:#1a1a1a; color:#fff; padding:16px; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; border:none; cursor:pointer; }

    /* Small controls */
    #new-arrivals-{{ section.id }} .na-qty { display:flex; gap:8px; align-items:center; }
    #new-arrivals-{{ section.id }} .na-qty button { padding:6px 8px; border:1px solid #e6e6e6; background:#fff; cursor:pointer; }

    /* Simple spinner */
    #new-arrivals-{{ section.id }} .na-spinner { width:16px;height:16px;border:2px solid rgba(0,0,0,0.2);border-top-color:#111;border-radius:50%;animation:na-spin .8s linear infinite;display:inline-block;vertical-align:middle }
    @keyframes na-spin { to { transform: rotate(360deg); } }
  </style>

  <div class="na-inner">
    <h2 class="na-heading">{{ section.settings.heading }}</h2>

    <div class="na-row" role="list">
      {% for product in products %}
        <div class="na-card" data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}">
          <a href="{{ product.url }}" class="na-link" aria-hidden="true" tabindex="-1">
            <div class="na-image-wrap">
              {% if product.featured_image %}
                <img class="na-image na-image--primary" src="{{ product.featured_image | image_url: 800 }}" srcset="{{ product.featured_image | image_url: 600 }} 600w, {{ product.featured_image | image_url: 900 }} 900w, {{ product.featured_image | image_url: 1200 }} 1200w" sizes="(min-width:750px) 320px, 240px" loading="lazy" alt="{{ product.title }}">
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'na-placeholder' }}
              {% endif %}

              {% assign second_media = product.media | where: 'media_type', 'image' | slice: 1, 1 | first %}
              {% if second_media and second_media.preview_image %}
                <img class="na-image na-image--secondary" src="{{ second_media.preview_image | image_url: 800 }}" srcset="{{ second_media.preview_image | image_url: 600 }} 600w, {{ second_media.preview_image | image_url: 900 }} 900w, {{ second_media.preview_image | image_url: 1200 }} 1200w" sizes="(min-width:750px) 320px, 240px" loading="lazy" alt="{{ product.title }} - alternate">
              {% endif %}

              <div class="na-quick-wrap">
                <button type="button" class="na-quick" data-action="quick-add">{{ section.settings.quick_add_label }}</button>
                <div class="na-variant-list" style="display:none;" aria-hidden="true"></div>
              </div>
            </div>
          </a>

          <div class="na-info">
            <div class="na-title">{{ product.title }}</div>
            <div class="na-price">
              {% if product.compare_at_price_max > product.price %}
                <span class="na-compare">{{ product.compare_at_price_max | money }}</span>
                <span class="na-current">{{ product.price | money }}</span>
              {% else %}
                <span class="na-current">{{ product.price | money }}</span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Cart Drawer -->
  <div class="na-cart-overlay" aria-hidden="true"></div>
  <aside class="na-cart-drawer" aria-hidden="true" role="dialog" aria-label="Cart">
    <div class="na-cart-header">
      <div class="na-cart-title">YOUR CART</div>
      <button type="button" class="na-cart-close" aria-label="Close">&times;</button>
    </div>
    <div class="na-cart-items" role="list"></div>
    <div class="na-cart-footer">
      <div class="na-subtotal" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;"><strong>SUBTOTAL</strong><span class="na-subtotal-amount">—</span></div>
      <a href="/checkout" class="na-checkout">CHECKOUT</a>
    </div>
  </aside>

  <script>
