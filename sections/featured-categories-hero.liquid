{% liquid
  assign rows = section.blocks.size
%}

<section class="featured-categories-hero spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="featured-categories-hero__wrapper">
    {% for block in section.blocks %}
      <div class="featured-categories-hero__item" {{ block.shopify_attributes }}>
        {% if block.settings.image %}
          <div class="featured-categories-hero__image">
            {% render 'image',
              image: block.settings.image,
              sizes: '50vw',
              classes: 'featured-categories-hero__img'
            %}
          </div>
        {% else %}
          <div class="featured-categories-hero__image featured-categories-hero__image--placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}

        <div class="featured-categories-hero__content">
          {% if block.settings.heading %}
            <h2 class="featured-categories-hero__heading">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.collection %}
            <a href="{{ block.settings.collection.url }}" class="featured-categories-hero__button button">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .featured-categories-hero {
    padding: 0;
  }

  .featured-categories-hero__wrapper {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0;
    min-height: 400px;

    @media screen and (max-width: 749px) {
      grid-template-columns: 1fr;
      min-height: 300px;
    }
  }

  .featured-categories-hero__item {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    min-height: 100%;
  }

  .featured-categories-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .featured-categories-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-categories-hero__image--placeholder {
    background-color: var(--color-background-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .featured-categories-hero__image--placeholder svg {
    width: 100px;
    height: 100px;
    opacity: 0.2;
  }

  .featured-categories-hero__content {
    position: relative;
    z-index: 2;
    padding: var(--padding-lg);
    width: 100%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.3) 60%,
      transparent 100%
    );
    color: white;
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
  }

  .featured-categories-hero__heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    margin: 0;
    letter-spacing: 0.1em;
  }

  .featured-categories-hero__button {
    align-self: flex-start;
    padding: var(--padding-sm) var(--padding-md);
    border: 1px solid white;
    background-color: transparent;
    color: white;
    text-decoration: underline;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    transition: all var(--animation-speed) var(--animation-easing);

    &:hover {
      background-color: white;
      color: black;
    }
  }

  @media screen and (min-width: 750px) {
    .featured-categories-hero__wrapper {
      grid-template-columns: repeat(2, 1fr);
      min-height: 500px;
    }

    .featured-categories-hero__item {
      &:first-child {
        grid-column: 1;
      }

      &:last-child {
        grid-column: 2;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Categories Hero",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "primary"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "placeholder": "Category Name",
          "default": "Category"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "SHOP NOW"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Categories Hero",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "heading": "WOMEN"
          }
        },
        {
          "type": "category",
          "settings": {
            "heading": "MEN"
          }
        }
      ]
    }
  ]
}
{% endschema %}
