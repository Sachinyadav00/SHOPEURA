{% liquid
  # Validate that we have exactly 2 blocks maximum
  assign block_count = section.blocks.size
  if block_count > 2
    assign block_count = 2
  endif
%}

<div id="dual-hero-{{ section.id }}" class="dual-collection-hero">
  <div class="dual-collection-hero__wrapper">
    {% for block in section.blocks limit: 2 %}
      <div class="dual-collection-hero__panel" {{ block.shopify_attributes }}>
        {%- comment -%} Image Container {%- endcomment -%}
        <div class="dual-collection-hero__image-wrapper">
          {% if block.settings.image %}
            {%- assign img_url = block.settings.image | image_url: width: 1200 -%}
            <img
              class="dual-collection-hero__image"
              src="{{ img_url }}"
              alt="{{ block.settings.heading | escape }}"
              srcset="
                {{ block.settings.image | image_url: width: 600 }} 600w,
                {{ block.settings.image | image_url: width: 900 }} 900w,
                {{ block.settings.image | image_url: width: 1200 }} 1200w
              "
              sizes="(min-width: 750px) 50vw, 100vw"
              loading="lazy"
            />
          {% else %}
            <div class="dual-collection-hero__image dual-collection-hero__image--placeholder">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}

          {%- comment -%} Dark Gradient Overlay for Text Legibility {%- endcomment -%}
          <div class="dual-collection-hero__gradient-overlay"></div>

          {%- comment -%} Content Overlaid on Image {%- endcomment -%}
          <div class="dual-collection-hero__content">
            <h2 class="dual-collection-hero__heading">
              {{ block.settings.heading | escape | upcase }}
            </h2>

            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="dual-collection-hero__cta">
                {{ block.settings.cta_label | escape | upcase }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  #dual-hero-{{ section.id }} {
    --dual-hero-gap: {{ section.settings.gap_between_panels }}px;
  }

  .dual-collection-hero {
    width: 100%;
    display: block;
  }

  .dual-collection-hero__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--dual-hero-gap);
    max-width: 100%;

    @media screen and (max-width: 749px) {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .dual-collection-hero__panel {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  {%- comment -%}
    Image Container with 2:3 portrait aspect ratio
    Position relative for absolute positioning of overlay content
  {%- endcomment -%}
  .dual-collection-hero__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    flex-shrink: 0;
  }

  .dual-collection-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.6s ease;
  }

  .dual-collection-hero__image--placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--color-background-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dual-collection-hero__image--placeholder svg {
    width: 80px;
    height: 80px;
    opacity: 0.15;
  }

  {%- comment -%}
    Hover effect: scale image
  {%- endcomment -%}
  .dual-collection-hero__panel:hover .dual-collection-hero__image {
    transform: scale(1.03);
  }

  {%- comment -%}
    Gradient overlay for text legibility
  {%- endcomment -%}
  .dual-collection-hero__gradient-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45) 0%, transparent 45%);
    pointer-events: none;
    z-index: 1;
  }

  {%- comment -%}
    Content overlaid on image, positioned bottom-left
  {%- endcomment -%}
  .dual-collection-hero__content {
    position: absolute;
    bottom: 28px;
    left: 28px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  {%- comment -%}
    Heading: white, responsive, overlay style
  {%- endcomment -%}
  .dual-collection-hero__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1;
    color: #ffffff;
    margin: 0;
    margin-bottom: 10px;
  }

  {%- comment -%}
    CTA Link: white text with underline, no box styling
  {%- endcomment -%}
  .dual-collection-hero__cta {
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    border: none;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.8);
    padding-bottom: 3px;
    background-color: transparent;
    cursor: pointer;
    display: inline-block;
    transition: opacity 0.2s ease;
    line-height: 1;
    width: fit-content;
  }

  .dual-collection-hero__cta:hover,
  .dual-collection-hero__cta:focus {
    opacity: 0.75;
  }

  @media screen and (max-width: 749px) {
    .dual-collection-hero__heading {
      font-size: clamp(2rem, 10vw, 2.5rem);
    }

    .dual-collection-hero__content {
      bottom: 28px;
      left: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dual Collection Hero",
  "settings": [
    {
      "type": "range",
      "id": "gap_between_panels",
      "label": "Gap Between Panels (Desktop)",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection Panel",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "placeholder": "e.g., Women",
          "default": "Women"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button Label",
          "placeholder": "e.g., Shop Now",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dual Collection Hero",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "heading": "WOMEN",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "collection",
          "settings": {
            "heading": "MEN",
            "cta_label": "SHOP NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}
